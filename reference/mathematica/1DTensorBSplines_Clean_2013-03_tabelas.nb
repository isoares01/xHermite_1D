Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Defini\[CCedilla]\[ATilde]o", " ", "da", " ", "fun\[CCedilla]\[ATilde]o", 
    " ", "fractal", " ", "de", " ", "Weierstrass", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["F", "a"], 
       RowBox[{"(", "x", ")"}]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "\[Infinity]"], 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{
          SuperscriptBox["\[Pi]k", "a"], "x"}], "]"}], "/", 
        RowBox[{"(", 
         SuperscriptBox["\[Pi]k", "a"], ")"}]}]}]}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AxesFontSize", "=", "15"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"WeierstrassFunction", "[", 
      RowBox[{"a_", ",", "x_"}], "]"}], ":=", 
     RowBox[{"N", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"Pi", "*", "x", "*", " ", 
           RowBox[{"k", "^", "a"}]}], " ", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"Pi", "*", 
           RowBox[{"k", "^", "a"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "250"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"WS", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"WeierstrassFunction", "[", 
       RowBox[{"2", ",", "x"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Visualiza\[CCedilla]\[ATilde]o", " ", "para", " ", "k"}], "=", 
     "3"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"WS1", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"WeierstrassFunction", "[", 
       RowBox[{"3", ",", "x"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
   RowBox[{"(*", " ", 
    RowBox[{
