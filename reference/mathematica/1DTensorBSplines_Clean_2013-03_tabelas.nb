    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"WeierstrassFunction", "[", 
       RowBox[{"4", ",", "x"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Visualiza\[CCedilla]\[ATilde]o", " ", "para", " ", "k"}], "=", 
     "3"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"WS3", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"WeierstrassFunction", "[", 
       RowBox[{"5", ",", "x"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
